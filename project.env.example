# Per-person settings for this pipeline. Copy to project.env and fill in.
# None of these are secrets; project.env is meant to be committed (keep the repo private).

GCP_PROJECT_ID=my-garmin-project          # Google Cloud project ID
GCP_PROJECT_NUMBER=123456789012           # gcloud projects describe $GCP_PROJECT_ID --format='value(projectNumber)'
BQ_LOCATION=EU                            # BigQuery location for both datasets
SECRET_LOCATION=europe-west1              # Secret Manager region for the Garmin tokens
USER_EMAIL=me@example.com                 # Google account that runs things locally and signs in to MCP
GITHUB_REPO=my-github-user/garmin-bigquery-mcp
GITHUB_REPO_ID=000000000                  # gh api repos/$GITHUB_REPO --jq .id
SYNC_TZ=Europe/Madrid                     # IANA timezone for the sync schedule (see .github/workflows/daily-sync.yml)
